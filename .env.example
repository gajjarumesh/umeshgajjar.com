# Site Configuration
NEXT_PUBLIC_SITE_URL=https://umeshgajjar.com

# SMTP Configuration for Contact Form
# Use your SMTP provider credentials (Gmail, SendGrid, AWS SES, etc.)

# SMTP Host (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=587

# SMTP Authentication
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# SMTP Secure (true for 465, false for other ports)
SMTP_SECURE=false

# Email Addresses
# Email address that will receive contact form submissions
CONTACT_EMAIL_TO=hello@umeshgajjar.com

# Email address that will appear as the sender
CONTACT_EMAIL_FROM=noreply@umeshgajjar.com

# Email sender name
CONTACT_EMAIL_FROM_NAME=Umesh Gajjar Portfolio
